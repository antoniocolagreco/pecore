{
  "name": "jira-mcp-issue-comment",
  "description": "Post a comment on a Jira ticket through Atlassian Rovo.",
  "kind": "tracker",
  "provider": "jira",
  "mode": "mcp",
  "retry": 0,
  "server": "atlassian",
  "account": "atlassian",
  "tool": "addOrEditJiraIssueComment",
  "arguments": {
    "cloudId": "{params.cloudId}",
    "issueIdOrKey": "{ticket.id}",
    "commentBody": "{inputs.text}"
  },
  "params": {
    "type": "object",
    "properties": {
      "cloudId": {
        "type": "string",
        "minLength": 1,
        "description": "Atlassian Cloud site ID."
      },
      "ticket": {
        "type": "string"
      }
    },
    "required": [
      "cloudId"
    ]
  },
  "inputs": [
    "text"
  ],
  "outcomes": [
    "success",
    "failure"
  ],
  "failOutcomes": [
    "failure"
  ],
  "outcomeRules": [
    {
      "exitCode": 0,
      "outcome": "success"
    },
    {
      "exitCode": "other",
      "outcome": "failure"
    }
  ],
  "outputs": {
    "success": "document"
  }
}
