{
  "name": "resolve-rebase-conflicts",
  "tags": ["git", "rebase", "conflicts"],
  "description": "Resolve conflicts while rebasing the job branch onto its new base.",
  "kind": "agent",
  "prompt": "resolve-rebase-conflicts.md",
  "agent": { "tier": "strong" },
  "outcomes": ["success", "failure"],
  "outputs": { "failure": "text" },
  "failOutcomes": ["failure"],
  "changesFiles": true,
  "timeoutSec": 1800
}
