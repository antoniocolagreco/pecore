{
  "$schema": "../../schemas/node.json",
  "name": "builder",
  "tags": ["implementation"],
  "description": "Implements the spec by filling the stubs until the tests pass; never edits tests; reports a test it believes is wrong instead of changing it",
  "kind": "agent",
  "prompt": "builder.md",
  "agent": { "tier": "strong" },
  "inputs": ["ticket", "spec"],
  "optionalInputs": ["check-log", "findings", "user-note"],
  "outputs": [],
  "outcomes": ["done", "tests_disputed"],
  "changesFiles": true,
  "timeoutSec": 3600,
  "outputSchema": {
    "type": "object",
    "required": ["outcome"],
    "properties": {
      "outcome": { "enum": ["done", "tests_disputed"] },
      "summary": { "type": "string" },
      "disputed": { "type": "array", "items": { "type": "object", "required": ["test", "reason"], "properties": { "test": { "type": "string" }, "reason": { "type": "string" } } } }
    }
  }
}
