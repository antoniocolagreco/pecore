{
  "name": "cargo-test",
  "tags": ["test"],
  "description": "Run the Rust tests with cargo test",
  "kind": "command",
  "command": ["cargo", "test"],
  "outcomes": ["passed", "failed"],
  "failOutcomes": ["failed"],
  "changesFiles": false,
  "outcomeRules": [
    { "exitCode": 0, "outcome": "passed" },
    { "exitCode": "other", "outcome": "failed" }
  ],
  "timeoutSec": 3600
}
