{
  "name": "cargo-test",
  "tags": ["test"],
  "description": "Run the Rust tests with cargo test",
  "kind": "command",
  "command": ["cargo", "test"],
  "outcomes": ["success", "failure"],
  "failOutcomes": ["failure"],
  "changesFiles": false,
  "outcomeRules": [
    { "exitCode": 0, "outcome": "success" },
    { "exitCode": "other", "outcome": "failure" }
  ],
  "timeoutSec": 3600
}
