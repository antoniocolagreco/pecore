{
  "name": "github-issues",
  "tags": ["issue tracker"],
  "description": "Read and comment on labeled GitHub issues.",
  "kind": "source",
  "credentials": ["project.account"],
  "params": {
    "type": "object",
    "properties": {
      "label": { "type": "string", "default": "factory" },
      "pollSec": { "type": "integer", "default": 300 },
      "trusted": { "type": "array", "items": { "type": "string" }, "default": [] }
    }
  },
  "list": { "script": "github-issues-list.sh", "outputRules": {} },
  "read": { "script": "github-issues-read.sh", "outputRules": {} },
  "comment": { "script": "github-issues-comment.sh", "outputRules": {} },
  "replies": { "script": "github-issues-replies.sh", "outputRules": {} },
  "timeoutSec": 120
}
