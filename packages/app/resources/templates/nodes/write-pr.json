{
  "$schema": "../../schemas/node.json",
  "name": "write-pr",
  "description": "Write a pull request title and description from the ticket, diff, and verification results.",
  "tags": ["github", "source control"],
  "kind": "agent",
  "prompt": "write-pr.md",
  "agent": { "tier": "standard" },
  "outcomes": ["done"],
  "outputs": { "done": "document" },
  "changesFiles": false,
  "timeoutSec": 300
}
