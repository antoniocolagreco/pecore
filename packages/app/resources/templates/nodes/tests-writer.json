{
  "$schema": "../../schemas/node.json",
  "name": "tests-writer",
  "tags": ["test"],
  "description": "Writes the tests the spec asks for, and stubs of the spec's interfaces that throw \"not implemented\", so the tests compile and fail",
  "kind": "agent",
  "prompt": "tests-writer.md",
  "agent": { "tier": "strong" },
  "inputs": ["ticket", "spec"],
  "optionalInputs": ["check-log"],
  "outputs": [],
  "outcomes": ["done"],
  "changesFiles": true,
  "timeoutSec": 2700,
  "outputSchema": {
    "type": "object",
    "required": ["outcome"],
    "properties": { "outcome": { "enum": ["done"] }, "summary": { "type": "string" } }
  }
}
