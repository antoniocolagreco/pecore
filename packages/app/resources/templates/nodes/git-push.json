{
  "name": "git-push",
  "tags": ["source control"],
  "description": "Push the job commit with a lease on the remote branch head.",
  "kind": "command",
  "runsAs": "engine",
  "credentials": ["project.account"],
  "outcomes": ["pushed", "failed"],
  "outputs": { "pushed": "reference" },
  "failOutcomes": ["failed"],
  "changesFiles": false,
  "script": "git-push.sh",
  "probe": { "script": "git-push-probe.sh" },
  "probeRules": { "stdoutJson": "state", "done": ["same"], "notDone": ["absent", "other"] },
  "outcomeRules": [
    { "exitCode": 0, "outcome": "pushed" },
    { "exitCode": "other", "outcome": "failed" }
  ],
  "outputRules": { "pushed": { "stdoutLastLine": "ref" } },
  "timeoutSec": 120
}
