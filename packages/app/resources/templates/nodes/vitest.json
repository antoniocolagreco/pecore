{
  "name": "vitest",
  "tags": ["test"],
  "description": "Run Vitest. The suite parameter selects a Vitest project. Leave it empty to run all projects.",
  "kind": "command",
  "params": {
    "type": "object",
    "properties": { "suite": { "type": "string", "default": "" } }
  },
  "script": "vitest.sh",
  "outcomes": ["success", "failure"],
  "failOutcomes": ["failure"],
  "changesFiles": false,
  "scratchPaths": ["coverage/**"],
  "outcomeRules": [
    { "exitCode": 0, "outcome": "success" },
    { "exitCode": "other", "outcome": "failure" }
  ],
  "timeoutSec": 1800
}
