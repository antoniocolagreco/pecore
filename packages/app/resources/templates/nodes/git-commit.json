{
  "name": "git-commit",
  "tags": ["source control"],
  "description": "Commit every change in the workdir to the job branch; done also when there is nothing new to commit",
  "kind": "command",
  "script": "git-commit.sh",
  "outcomes": ["success", "failure"],
  "outputs": { "success": "sha" },
  "failOutcomes": ["failure"],
  "changesFiles": false,
  "outcomeRules": [
    { "exitCode": 0, "outcome": "success" },
    { "exitCode": "other", "outcome": "failure" }
  ],
  "outputRules": { "success": { "stdoutLastLine": "sha" } },
  "timeoutSec": 120
}
