{
  "name": "jira-mcp-ticket-read",
  "description": "Read a Jira ticket by key or link through Atlassian Rovo.",
  "kind": "tracker",
  "provider": "jira",
  "mode": "mcp",
  "server": "atlassian",
  "account": "atlassian",
  "tool": "getJiraIssue",
  "readOnly": true,
  "arguments": {
    "cloudId": "{params.cloudId}",
    "issueIdOrKey": "{ticket.id}"
  },
  "params": {
    "type": "object",
    "properties": {
      "cloudId": {
        "type": "string",
        "minLength": 1,
        "description": "Atlassian Cloud site ID."
      },
      "ticket": {
        "type": "string"
      }
    },
    "required": [
      "cloudId"
    ]
  },
  "inputs": [],
  "outcomes": [
    "success",
    "failure"
  ],
  "failOutcomes": [
    "failure"
  ],
  "outcomeRules": [
    {
      "exitCode": 0,
      "outcome": "success"
    },
    {
      "exitCode": "other",
      "outcome": "failure"
    }
  ],
  "outputs": {
    "success": "document"
  }
}
