{
  "name": "eslint",
  "tags": ["lint"],
  "description": "Run ESLint on the whole project",
  "kind": "command",
  "command": ["npx", "--no-install", "eslint", "."],
  "outcomes": ["success", "failure"],
  "failOutcomes": ["failure"],
  "changesFiles": false,
  "scratchPaths": [".eslintcache"],
  "outcomeRules": [
    { "exitCode": 0, "outcome": "success" },
    { "exitCode": "other", "outcome": "failure" }
  ],
  "timeoutSec": 600
}
