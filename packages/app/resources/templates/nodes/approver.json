{
  "$schema": "../../schemas/node.json",
  "name": "approver",
  "description": "Classifies each hunk of the job's diff as safe or risky, with a reason, so the human review shows risky hunks first",
  "kind": "agent",
  "prompt": "approver.md",
  "agent": { "tier": "standard" },
  "inputs": ["diff"],
  "optionalInputs": ["spec", "findings"],
  "outputs": ["risk"],
  "outcomes": ["done"],
  "changesFiles": false,
  "timeoutSec": 1200,
  "outputSchema": {
    "type": "object",
    "required": ["outcome", "risk"],
    "properties": {
      "outcome": { "enum": ["done"] },
      "risk": {
        "type": "object",
        "required": ["hunks"],
        "properties": {
          "hunks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "hunkIndex", "level", "reason"],
              "properties": { "file": { "type": "string" }, "hunkIndex": { "type": "integer", "minimum": 0 }, "level": { "enum": ["safe", "risky"] }, "reason": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
