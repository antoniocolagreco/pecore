{
  "name": "git-rebase",
  "tags": ["source control"],
  "description": "Rebase the job branch onto its new base and restore uncommitted changes.",
  "kind": "command",
  "script": "git-rebase.sh",
  "outcomes": ["success", "rebase_conflict"],
  "changesFiles": true,
  "outcomeRules": [
    { "exitCode": 0, "outcome": "success" },
    { "exitCode": "other", "outcome": "rebase_conflict" }
  ],
  "timeoutSec": 600
}
