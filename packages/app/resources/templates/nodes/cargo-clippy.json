{
  "$schema": "../../schemas/node.json",
  "name": "cargo-clippy",
  "description": "Lint a Rust project with clippy; warnings fail the check",
  "kind": "command",
  "command": ["cargo", "clippy", "--all-targets", "--", "-D", "warnings"],
  "outcomes": ["passed", "failed"],
  "failOutcomes": ["failed"],
  "changesFiles": false,
  "outcomeRules": [
    { "exitCode": 0, "outcome": "passed" },
    { "exitCode": "other", "outcome": "failed" }
  ],
  "timeoutSec": 1800
}
