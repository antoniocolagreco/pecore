{
  "name": "cargo-clippy",
  "tags": ["lint"],
  "description": "Lint a Rust project with clippy; warnings fail the check",
  "kind": "command",
  "command": ["cargo", "clippy", "--all-targets", "--", "-D", "warnings"],
  "outcomes": ["success", "failure"],
  "failOutcomes": ["failure"],
  "changesFiles": false,
  "outcomeRules": [
    { "exitCode": 0, "outcome": "success" },
    { "exitCode": "other", "outcome": "failure" }
  ],
  "timeoutSec": 1800
}
