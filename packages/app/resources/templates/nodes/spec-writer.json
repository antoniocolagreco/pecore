{
  "$schema": "../../schemas/node.json",
  "name": "spec-writer",
  "description": "Reads the ticket and the code, and writes a spec: acceptance criteria, what the tests must check, the interfaces to add or change, and optional nodes to run; rejects a ticket that is unclear or not feasible",
  "kind": "agent",
  "prompt": "spec-writer.md",
  "agent": { "tier": "strong" },
  "inputs": ["ticket"],
  "outputs": ["spec"],
  "outcomes": ["accepted", "rejected"],
  "changesFiles": false,
  "timeoutSec": 1800,
  "outputSchema": {
    "type": "object",
    "required": ["outcome", "spec"],
    "properties": {
      "outcome": { "enum": ["accepted", "rejected"] },
      "reason": { "type": "string" },
      "spec": {
        "type": "object",
        "required": ["criteria", "tests", "interfaces"],
        "properties": {
          "criteria": { "type": "array", "items": { "type": "string" } },
          "tests": { "type": "array", "items": { "type": "string" } },
          "interfaces": {
            "type": "array",
            "items": { "type": "object", "required": ["name", "signature"], "properties": { "name": { "type": "string" }, "signature": { "type": "string" } } }
          },
          "optionalNodes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
