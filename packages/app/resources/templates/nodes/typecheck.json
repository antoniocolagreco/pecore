{
  "name": "typecheck",
  "tags": ["check"],
  "description": "Run the TypeScript type checker on the project (tsc --noEmit)",
  "kind": "command",
  "command": ["npx", "--no-install", "tsc", "--noEmit"],
  "outcomes": ["success", "failure"],
  "failOutcomes": ["failure"],
  "changesFiles": false,
  "scratchPaths": ["**/*.tsbuildinfo"],
  "outcomeRules": [
    { "exitCode": 0, "outcome": "success" },
    { "exitCode": "other", "outcome": "failure" }
  ],
  "timeoutSec": 600
}
