{
  "name": "cargo-check",
  "tags": ["rust", "check"],
  "description": "Type-check a Rust project with cargo check, tests included",
  "kind": "command",
  "command": ["cargo", "check", "--all-targets"],
  "outcomes": ["success", "failure"],
  "failOutcomes": ["failure"],
  "changesFiles": false,
  "outcomeRules": [
    { "exitCode": 0, "outcome": "success" },
    { "exitCode": "other", "outcome": "failure" }
  ],
  "timeoutSec": 1800
}
