{
  "name": "tests-fail-check",
  "tags": ["test"],
  "description": "Run Vitest to check that the tests fail before the fix.",
  "kind": "command",
  "params": {
    "type": "object",
    "properties": { "suite": { "type": "string", "default": "" } }
  },
  "script": "tests-fail-check.sh",
  "outcomes": ["success", "failure"],
  "changesFiles": false,
  "scratchPaths": ["coverage/**"],
  "outcomeRules": [
    { "exitCode": 0, "outcome": "success" },
    { "exitCode": "other", "outcome": "failure" }
  ],
  "timeoutSec": 1800
}
