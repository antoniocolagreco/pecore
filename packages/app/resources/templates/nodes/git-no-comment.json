{
  "$schema": "../../schemas/node.json",
  "name": "git-no-comment",
  "description": "Complete the comment step for a private Git server.",
  "kind": "command",
  "runsAs": "engine",
  "credentials": ["project.account"],
  "inputs": ["delivery"],
  "outcomes": ["done", "failed"],
  "failOutcomes": ["failed"],
  "changesFiles": false,
  "command": ["true"],
  "probe": ["true"],
  "outcomeRules": [
    { "exitCode": 0, "outcome": "done" },
    { "exitCode": "other", "outcome": "failed" }
  ],
  "timeoutSec": 120
}
