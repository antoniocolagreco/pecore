{
  "name": "markdown-folder",
  "tags": ["issue tracker"],
  "description": "Read Markdown tickets and append replies in the configured folder.",
  "kind": "source",
  "credentials": ["project.account"],
  "params": {
    "type": "object",
    "properties": {
      "folder": { "type": "string" },
      "label": { "type": "string", "default": "factory" },
      "pollSec": { "type": "integer", "default": 300 },
      "trusted": { "type": "array", "items": { "type": "string" }, "default": [] }
    },
    "required": ["folder"]
  },
  "list": { "script": "markdown-folder-list.sh", "outputRules": {} },
  "read": { "script": "markdown-folder-read.sh", "outputRules": {} },
  "comment": { "script": "markdown-folder-comment.sh", "outputRules": {} },
  "replies": { "script": "markdown-folder-replies.sh", "outputRules": {} },
  "timeoutSec": 120
}
