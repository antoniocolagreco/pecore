{
  "name": "git-delivery",
  "tags": ["source control"],
  "description": "Report the pushed job branch as the delivery.",
  "kind": "repository",
  "account": "project.account",
  "outcomes": ["success", "failure"],
  "failOutcomes": ["failure"],
  "changesFiles": false,
  "script": "set -eu\nprintf '%s\\n' \"$PECORE_JOB_BRANCH\"",
  "probe": { "script": "git-delivery.sh" },
  "mergedCheck": { "script": "git-delivery-merged.sh" },
  "mergedCheckRules": { "stdoutJson": "state", "done": ["merged"], "notDone": ["unmerged"] },
  "outcomeRules": [
    { "exitCode": 0, "outcome": "success" },
    { "exitCode": "other", "outcome": "failure" }
  ],
  "timeoutSec": 120
}
