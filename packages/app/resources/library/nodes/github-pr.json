{
  "$schema": "../../schemas/node.json",
  "name": "github-pr",
  "description": "Open a GitHub pull request for the job branch or move it to the job's target branch.",
  "kind": "command",
  "runsAs": "engine",
  "credentials": ["project.account"],
  "inputs": ["commit", "spec"],
  "outputs": ["delivery"],
  "outcomes": ["opened", "failed"],
  "failOutcomes": ["failed"],
  "changesFiles": false,
  "script": "github-pr.sh",
  "outcomeRules": [
    { "exitCode": 0, "outcome": "opened" },
    { "exitCode": "other", "outcome": "failed" }
  ],
  "outputRules": { "delivery": { "stdoutLastLine": "url" } },
  "probe": ["gh", "pr", "list", "--repo", "{project.repo.owner}/{project.repo.name}", "--head", "{job.branch}", "--base", "{job.target}", "--json", "url", "--jq", ".[0].url // empty"],
  "mergedCheck": ["gh", "pr", "view", "--repo", "{project.repo.owner}/{project.repo.name}", "{job.branch}", "--json", "state", "--jq", "select(.state==\"MERGED\") | .state"],
  "timeoutSec": 120
}
