{
  "name": "@pecore/app",
  "productName": "<PE/CORE>",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "gallery": "vite --config gallery.vite.config.ts",
    "gallery:build": "vite build --config gallery.vite.config.ts",
    "dist": "pnpm --filter @pecore/agents build-adapters && pnpm build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
