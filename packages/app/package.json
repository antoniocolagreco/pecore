    "@codemirror/legacy-modes": "6.5.5",
    "@lezer/highlight": "1.2.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@pecore/engine": "workspace:*",
    "@pecore/schemas": "workspace:*",
    "@xyflow/react": "12.12.1",
    "better-sqlite3": "13.2.0",
    "cmdk": "1.1.1",
    "codemirror": "6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
