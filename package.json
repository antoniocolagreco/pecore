{
  "name": "pecore",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "postinstall": "electron-rebuild -f -o better-sqlite3",
    "dev": "pnpm --filter @pecore/agents build-adapters && pnpm --filter @pecore/app dev",
    "build": "pnpm -r run build",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/app/tsconfig.renderer.json --noEmit",
    "dist": "pnpm -r run dist"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "electron": "45.3.4",
    "eslint": "10.15.0",
    "fast-check": "4.10.2",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
